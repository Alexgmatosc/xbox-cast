# Configuración opcional para despliegue en Vercel con Supabase Realtime
# (En modo desarrollo local con npm run dev NO es necesario configurar nada)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Puerto del servidor de señalización local (por defecto 3001)
NEXT_PUBLIC_LOCAL_SIGNAL_PORT=3001
