# Supabase Realtime (Para despliegue serverless en Vercel con señalización E2EE)
# Obtén estos valores en tu consola de Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_clave_publica_anon_o_publishable

# Puerto del servidor WebSocket de señalización local (Solo para desarrollo offline)
NEXT_PUBLIC_LOCAL_SIGNAL_PORT=3001

# Panel de depuración en pantalla (opcional: true para mostrar logs/ICE/FPS en UI)
NEXT_PUBLIC_DEBUG=false
